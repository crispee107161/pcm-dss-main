generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MARKETING_MANAGER
  MARKETING_TEAM
  BUSINESS_OWNER
}

enum UploadType {
  ADS_CSV
  POSTS_CSV
  PAGE_METRIC_CSV
  FOLLOWER_HISTORY_CSV
  PAGE_VIEWERS_CSV
  DEMOGRAPHICS_CSV
}

enum UploadStatus {
  SUCCESS
  FAILED
}

enum CategoryLabel {
  PRODUCT_SHOWCASE
  PROMOTIONAL_OFFER
  TESTIMONIAL
  ENTERTAINMENT
  UNCLASSIFIED
  /// A legitimate 5th label from the external ground-truth codebook
  /// (CODEBOOK_content_categories.md §5) — a human coder's genuine "cannot
  /// decide" verdict. Never produced by ALG-04/ALG-05 (those return
  /// UNCLASSIFIED instead); only ever arrives via the ground-truth CSV import.
  UNCLEAR
}

/// Developer_Note_Ground_Truth_Labelling.md §4 — distinguishes *how*
/// category_final was set, so a contamination check can prove the external
/// ground-truth sample was never touched by an accepted suggestion.
enum CategoryFinalSource {
  MANUAL_GROUND_TRUTH
  ACCEPTED_SUGGESTION
  MANUAL_OVERRIDE
}

/// docs/raven/S4_Categorisation_Review_UI_Change.md §2.1/§3.2 — S4's triage
/// signal. Specific condition(s), not a boolean, so Chapter 4 can report a
/// per-condition breakdown ("X flagged for disagreement, Y for..."). The
/// review screen shows generic wording built from this set; it never names
/// which method (category_keyword vs category_llm) produced which value —
/// see lib/categorize/flag-reasons.ts.
enum CategoryFlagReason {
  DISAGREEMENT
  UNCLASSIFIED
  /// docs/raven/S4_Flag_Thresholds_Answers.md §2 — unconditional, not a
  /// rarity computation. Entertainment is defined partly by visual features
  /// a caption can't convey, and FR-08's n=200 ground-truth run showed the
  /// LLM over-assigns it (38 predicted vs. 12 actual, ~29% precision). A
  /// dynamic rarity threshold was rejected: circular (computed from the
  /// review it's meant to guide), order-dependent, and irreproducible for
  /// the Chapter 4 breakdown.
  ENTERTAINMENT_SUGGESTED
  SHORT_CAPTION
}

// FR-24 audit trail — the "manual category assignment" half. UploadLog
// (above) already covers uploads; this covers every human decision made on
// S4 Categorisation Review. Deliberately excludes ALG-04's autoCategorizeAll
// (an automated suggestion pass, not a manual assignment).
enum CategoryAuditAction {
  PROPOSE
  ACCEPT
  REJECT
  OVERRIDE
  BULK_ACCEPT
  /// docs/raven/S4_Categorisation_Review_UI_Change.md §2.2 — a Manager
  /// batch-confirming every unflagged, both-methods-agreed post at once.
  /// Distinct from BULK_ACCEPT, which finalises MARKETING_TEAM proposals.
  BATCH_CONFIRM
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  password_hash              String
  role                       Role
  created_at                 DateTime           @default(now())
  upload_logs                UploadLog[]
  simulation_results         SimulationResult[]
  category_proposals         FacebookPost[]
  category_audit_logs        CategoryAuditLog[]
  category_final_assignments FacebookPost[]     @relation("CategoryFinalAssignedBy")
}

model UploadLog {
  id                 Int          @id @default(autoincrement())
  user_id            Int
  user               User         @relation(fields: [user_id], references: [id])
  upload_type        UploadType
  filename           String
  status             UploadStatus
  records_inserted   Int          @default(0)
  records_updated    Int          @default(0)
  records_unchanged  Int          @default(0)
  records_superseded Int          @default(0)
  error_message      String?
  warning_message    String?
  uploaded_at        DateTime     @default(now())
}

model CategoryAuditLog {
  id                Int                 @id @default(autoincrement())
  user_id           Int
  user              User                @relation(fields: [user_id], references: [id])
  action            CategoryAuditAction
  // References FacebookPost.id (the Int PK), not its `post_id` string field.
  // No FK/relation: the log must survive independently of the post row.
  facebook_post_id  Int
  previous_category CategoryLabel?
  new_category      CategoryLabel?
  created_at        DateTime            @default(now())

  @@index([created_at])
}

/// Developer_Note_Ground_Truth_Labelling.md §6 — the one-time Cohen's kappa
/// between the two external coders (computed by compute_kappa.py, before any
/// discussion between them), stored so S8 can display it as the human
/// "ceiling" alongside the system's own method kappas. Not live-computed —
/// the raw per-coder sheets never enter this app (§2 rule 2's blindness
/// requirement applies to the coders, not to this system).
model InterCoderReliability {
  id                Int      @id @default(autoincrement())
  n                 Int
  percent_agreement Float
  kappa             Float
  computed_at       DateTime @default(now())
  notes             String?
}

model FacebookPost {
  id                            Int                  @id @default(autoincrement())
  post_id                       String               @unique
  publish_time                  DateTime
  post_type                     String
  title                         String?
  description                   String?
  permalink                     String
  reach                         Int
  reactions                     Int                  @default(0)
  comments                      Int                  @default(0)
  shares                        Int                  @default(0)
  /// Nullable, unlike the other counters — FR-19/ALG-07 must exclude posts
  /// with a genuinely blank "Views" export cell from the ranking comparison,
  /// not silently coerce them to 0 (which would corrupt both the
  /// correlation and the top-k overlap).
  views                         Int?
  /// Percentage, 0-100 (e.g. 4.2 means 4.2%). Already scaled — do not multiply by 100 again.
  engagement_rate               Float
  /// FR-28 watch-through rate inputs — populated for videos/reels only (397/730 posts).
  duration_sec                  Float?
  avg_seconds_viewed            Float?
  /// FR-15: three permanent columns, not a throwaway comparison. `category_final`
  /// is the single source of truth read by the rest of the app; keyword/llm are
  /// kept for the FR-15 agreement study (Cohen's kappa, confusion matrix).
  category_keyword              CategoryLabel?
  category_llm                  CategoryLabel?
  category_final                CategoryLabel?
  /// Developer_Note_Ground_Truth_Labelling.md §4 — how category_final was set.
  /// MANUAL_GROUND_TRUTH only ever arrives via the external codebook CSV
  /// import (scripts/import-ground-truth.ts); the S4 review actions
  /// (accept/override) stamp the other two values. This is what lets FR-15
  /// restrict its authoritative kappa to a genuinely blind reference standard
  /// instead of the S4 finalisation queue's own output.
  category_final_source         CategoryFinalSource?
  category_final_assigned_by_id Int?
  category_final_assigned_by    User?                @relation("CategoryFinalAssignedBy", fields: [category_final_assigned_by_id], references: [id])
  category_final_assigned_at    DateTime?
  /// FR-13: a MARKETING_TEAM proposal. Never read by anything outside the S4
  /// review queue — MARKETING_MANAGER accepting it is what copies the value
  /// into category_final; overriding directly clears it without copying.
  category_pending              CategoryLabel?
  category_pending_by           Int?
  pending_by                    User?                @relation(fields: [category_pending_by], references: [id])
  /// docs/raven/S4_Categorisation_Review_UI_Change.md §3.2 — computed and
  /// persisted by lib/data/category-flags.ts whenever category_keyword or
  /// category_llm changes. Every condition is a pure function of one post's
  /// own fields (ENTERTAINMENT_SUGGESTED's doc comment above explains why a
  /// cross-post rarity baseline was rejected), so the manuscript breakdown
  /// can't drift as later review activity finalises other posts. Empty
  /// while category_final is null and no condition has fired; meaningless
  /// (and left stale) once category_final is set — the post has left the queue.
  category_flag_reasons         CategoryFlagReason[] @default([])
  created_at                    DateTime             @default(now())
}

model Ad {
  id                       Int      @id @default(autoincrement())
  reporting_starts         DateTime
  reporting_ends           DateTime
  ad_id                    String
  ad_name                  String
  ad_set_id                String
  ad_set_name              String
  campaign_id              String
  campaign_name            String
  attribution_setting      String
  reach                    Int?
  impressions              Int
  link_clicks              Int?
  amount_spent             Float
  result_type              String?
  frequency                Float?
  post_engagements         Int?
  views                    Int?
  viewers                  Int?
  total_messaging_contacts Int?
  results                  Int?
  cost_per_result          Float?
  /// Permanently null on all data ingested since the messaging-conversations DV
  /// pivot (see DV-PIVOT-PLAN.md "Why this changed") — Purchases/sales data is out
  /// of scope by policy and no longer parsed from either CSV format. Column is kept,
  /// not dropped, to avoid an unreviewed migration against what may be a production
  /// database; a follow-up migration to remove it needs explicit sign-off first.
  inquiries                Int?
  created_at               DateTime @default(now())

  @@unique([ad_id, reporting_starts])
  @@index([ad_set_id])
  @@index([campaign_id])
  @@index([reporting_starts])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  keywords Keyword[]
}

model Keyword {
  id          Int      @id @default(autoincrement())
  word        String   @unique
  category_id Int
  category    Category @relation(fields: [category_id], references: [id])
}

/// ALG-05: one row per LLM classification batch. Kept permanently — a
/// panelist may ask how a label was produced, so the raw response, model
/// name, and run date must be reproducible per FR-15, not just the parsed
/// category_llm value on FacebookPost.
model LlmClassificationRun {
  id           Int      @id @default(autoincrement())
  model_name   String
  run_at       DateTime @default(now())
  post_ids     Int[]
  raw_response String
  succeeded    Boolean
}

enum CorrelationMethod {
  PEARSON
  SPEARMAN
}

/// ALG-08 (FR-21): one row per correlation-selection run. mvp.md's algorithm
/// spec explicitly requires persisting the Shapiro-Wilk assumption-test
/// result alongside the chosen method and coefficient — "a panelist may ask
/// how the method was chosen," not just what the final coefficient was.
/// Written once per S7 Analysis page load (cheap at n~187, and an audit
/// trail of every run is more defensible than a single overwritten row).
model CorrelationAssumptionRun {
  id          Int               @id @default(autoincrement())
  run_at      DateTime          @default(now())
  n           Int
  method      CorrelationMethod
  coefficient Float
  p_value     Float
  shapiro_x_w Float
  shapiro_x_p Float
  shapiro_y_w Float
  shapiro_y_p Float
}

enum RegressionSpecification {
  PRIMARY
  SECONDARY
}

/// FR-31 (docs/raven/FR31_Regression_Specification.md, amended by
/// docs/raven/FR31_Amendment_TypeScript_Implementation.md): one row per
/// specification (PRIMARY = spend >= the shared ₱1,000 threshold, n=108;
/// SECONDARY = all messaging ads, n=187) per S7 Analysis page load. Written
/// but never read back by the app — like CorrelationAssumptionRun, this is
/// a manuscript audit trail for Chapter 4, not application state. Flat
/// columns rather than a child coefficients table because the four
/// predictors are fixed by the spec, not user-configurable.
///
/// This is a DIFFERENT model from the cut-feature RegressionModel above
/// (messaging conversations ~ reach + spend, a predictive model) — do not
/// confuse the two. RegressionModel/lib/stats/regression.ts stay untouched.
model RegressionRun {
  id                   Int                     @id @default(autoincrement())
  run_at               DateTime                @default(now())
  specification        RegressionSpecification
  n                    Int
  min_spend_filter     Float?

  // Overall fit
  r_squared            Float
  adj_r_squared        Float
  f_statistic          Float
  f_p_value            Float
  residual_std_error   Float

  // Coefficients (term order: intercept, engagement_rate, frequency, ctr, cpm)
  intercept_coef       Float
  intercept_se_ols     Float
  intercept_se_hc3     Float
  intercept_p_ols      Float
  intercept_p_hc3      Float

  engagement_rate_coef   Float
  engagement_rate_se_ols Float
  engagement_rate_se_hc3 Float
  engagement_rate_p_ols  Float
  engagement_rate_p_hc3  Float
  engagement_rate_vif    Float

  frequency_coef       Float
  frequency_se_ols     Float
  frequency_se_hc3     Float
  frequency_p_ols      Float
  frequency_p_hc3      Float
  frequency_vif        Float

  ctr_coef             Float
  ctr_se_ols           Float
  ctr_se_hc3           Float
  ctr_p_ols            Float
  ctr_p_hc3            Float
  ctr_vif              Float

  cpm_coef             Float
  cpm_se_ols           Float
  cpm_se_hc3           Float
  cpm_p_ols            Float
  cpm_p_hc3            Float
  cpm_vif              Float

  // Diagnostics
  breusch_pagan_lm     Float
  breusch_pagan_p      Float
  jarque_bera_jb       Float
  jarque_bera_p        Float
  jarque_bera_skew     Float
  jarque_bera_exkurt   Float
  shapiro_wilk_w       Float?
  shapiro_wilk_p       Float?

  // Accuracy (primary specification only — the secondary row leaves these null)
  in_sample_mae        Float?
  in_sample_rmse       Float?
  in_sample_mape       Float?
  cv_r_squared         Float?
  cv_mae               Float?
  cv_rmse              Float?
  cv_mape              Float?
  baseline_mae         Float?
  baseline_rmse        Float?
  baseline_mape        Float?

  // Residual diagnostic (primary specification only)
  residual_flagged_count       Int?
  residual_flagged_total_spend Float?
}

model RegressionModel {
  id                   Int      @id @default(autoincrement())
  intercept            Float
  coefficient          Float
  coef_reach           Float?
  /// No longer written by new training runs since the messaging-conversations DV
  /// pivot — messaging is the model's outcome now, not a predictor (see
  /// DV-PIVOT-PLAN.md). Non-null only on legacy rows trained under the old formula;
  /// see scripts/purge-inquiry-regression-models.ts to clean those up.
  coef_messaging       Float?
  coef_amount_spent    Float?
  coef_spend_sq        Float?
  coef_link_clicks     Float?
  model_type           String?
  residual_std_error   Float?
  best_lag             Int?
  r_squared            Float
  adj_r_squared        Float?
  n                    Int
  /// Set when fitPlainMLR's VIF check (Reach/Spend collinearity) exceeds the
  /// warning threshold, or when the fit was numerically singular — surfaced
  /// in the UI (RegressionSummary) instead of only logging via console.warn.
  /// Null on legacy rows trained before this column existed.
  collinearity_warning String?
  trained_at           DateTime @default(now())
}

model SimulationResult {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  user                User     @relation(fields: [user_id], references: [id])
  reach_input         Float?
  /// Always null on new rows since the What-If Simulator dropped its messaging
  /// input (see DV-PIVOT-PLAN.md Phase 3) — messaging is the model's outcome now.
  messaging_input     Float?
  amount_spent_input  Float
  /// Holds a projected messaging-conversations count now, not inquiries — kept as
  /// the column name to avoid an unreviewed migration (see DV-PIVOT-PLAN.md).
  projected_inquiries Float
  interval_lower      Float?
  interval_upper      Float?
  model_id            Int
  simulated_at        DateTime @default(now())
}

// Page-level daily metrics (Follows, Interactions, Link Clicks, Views, Viewers, Visits)
// All 6 CSV files upsert into this single table by date
model PageMetricDaily {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  follows      Int?
  interactions Int?
  link_clicks  Int?
  views        Int?
  // Distinct metric from PageViewers.total_viewers (different source file, different
  // values on overlapping dates — e.g. 2025-08-19: 5780 vs 8876). Not a duplicate; do not merge.
  viewers      Int?
  visits       Int?
  created_at   DateTime @default(now())
}

// Daily follower counts from FollowerHistory.csv
model FollowerHistory {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  followers    Int
  daily_change Int
  created_at   DateTime @default(now())
}

// Daily viewer data from Viewers.csv
model PageViewers {
  id                Int      @id @default(autoincrement())
  date              DateTime @unique
  total_viewers     Int?
  new_viewers       Int
  returning_viewers Int
  created_at        DateTime @default(now())
}

// Follower gender distribution snapshot (FollowerGender.csv)
model FollowerGender {
  id           Int    @id @default(autoincrement())
  gender       String @unique
  distribution Float
}

// Follower territory distribution snapshot (FollowerTopTerritories.csv)
model FollowerTerritory {
  id           Int    @id @default(autoincrement())
  territory    String @unique
  distribution Float
}
