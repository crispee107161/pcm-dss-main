# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Groq API key — https://console.groq.com
GROQ_API_KEY="gsk_..."

# Seed passwords (only needed when running: npx prisma db seed)
# Must be at least 12 characters each. Pick unique, non-default values —
# these become real login credentials if the seed script is run.
SEED_MARKETING_PASSWORD="change-me-marketing"
SEED_MARKETING_TEAM_PASSWORD="change-me-team"
SEED_OWNER_PASSWORD="change-me-owner"
# Second BUSINESS_OWNER account (docs/raven/Two_Engagement_Rates_and_Owner_Deadlock.md
# §2) — lets either Owner unlock the other through the UI with no DB access
# and no one on standby.
SEED_OWNER2_PASSWORD="change-me-owner2"

# Seeded emails
# owner/owner2/marketing/team@pcmerchandise.com

# Canonical app origin, used by the PDF export route (app/api/reports/[role]/pdf)
# so headless Chromium always navigates to this app regardless of the
# incoming request's Host header. Falls back to the request origin if unset
# (fine for local dev, but should always be set in production).
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel-only build env var (set in the Vercel dashboard, NOT here) —
# skips downloading puppeteer's bundled Chromium during `npm install` on
# Vercel's build step, where the prod code path uses @sparticuz/chromium
# instead. Do NOT set this locally: local dev's PDF export relies on the
# full `puppeteer` package downloading its own Chromium (see lib/pdf/browser.ts).
# PUPPETEER_SKIP_DOWNLOAD=true
